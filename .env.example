# Отправка заявок в Telegram.
# Эти переменные нужны СЕРВЕРУ (в браузер не попадают).
#
# Локально: скопируйте файл в .env.local и впишите значения.
# На ПРОДАКШЕНЕ (Vercel и т.п.): .env.local НЕ деплоится — задайте эти же
# переменные в настройках проекта на хостинге, иначе формы на сайте не будут
# отправлять заявки (API вернёт ошибку "not-configured").
#   Vercel → Project → Settings → Environment Variables → добавить обе
#   переменные для окружения Production (и Preview), затем сделать Redeploy.
#
# Токен бота: @BotFather → /newbot.  chat_id: @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
